# Copiar a .env y ajustar. docker compose lo lee automáticamente.

# docker (SDK real) o simulator (contenedores ficticios, sin Docker)
BACKEND=docker
LOG_LEVEL=INFO

# New Relic (one.newrelic.com > API keys > INGEST - LICENSE). Vacío = sin monitoreo.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=devops-up

# GID del grupo dueño de /var/run/docker.sock.
# Docker Desktop: 0. Linux: getent group docker | cut -d: -f3
DOCKER_GID=0
